# Google Identity Services (OAuth 2.0 Web client)
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173 and your deployed origin
# Authorized redirect URIs: same origins (GIS button flow often only needs origins)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional display name for unlock email simulation
VITE_OPS_EMAIL=a.ferjani@waadacademy.edu.sa
